{
    "env": {
        "amd": true,
        "browser": true,
        "es6": true,
        "node": true
    },
    "globals": {
        "pg": true, // ProntoGioco
        "google": true // Google maps
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/recommended"
    ],
    "plugins": ["vue"],
    "parserOptions": {
        "sourceType": "module"
    },
    "rules": {
        "indent": ["error", "tab", {
            "SwitchCase": 1
        }],
        "linebreak-style": ["error", "unix"],
        "no-console": "off",
        "quotes": ["error", "single", {
            "avoidEscape": true
        }],
        "semi": ["error", "always"],
        "comma-dangle": ["error", "never"]
    }
}